# ==============================================================================
# FAO Properties — Environment Variables Example
# ==============================================================================
# Copy this file to `.env.local` for local development or set these variables
# in your hosting provider's environment settings (e.g., VPS, Railway, Render).
# DO NOT commit actual secrets or `.env.local` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMTP / Email Notifications Configuration
# ------------------------------------------------------------------------------
# Used by: src/lib/mailer.ts
# New lead submissions from the website forms are emailed to the sales team.
# If these are not configured, leads will still be saved to `data/leads.xlsx`,
# but email delivery will be skipped.

# SMTP server hostname (e.g., smtp.gmail.com for Google Workspace / Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP port (465 for SSL, 587 for TLS). Default in code is 465.
SMTP_PORT=465

# Whether to use SSL/TLS directly ("true" or "false"). Default is true unless explicitly "false".
SMTP_SECURE=true

# SMTP authentication username / sending email address
SMTP_USER=your-email@gmail.com

# SMTP password (For Gmail, use a 16-character App Password generated at:
# https://myaccount.google.com/apppasswords - requires 2-Step Verification)
SMTP_PASS=your-16-char-app-password

# Recipient email address where new lead alert emails will be delivered
LEAD_NOTIFY_EMAIL=fao@faoproperties.com


# ------------------------------------------------------------------------------
# 2. Security & Session Secret
# ------------------------------------------------------------------------------
# Used by: src/lib/download-token.ts, src/lib/admin-auth.ts
# Critical secret key used for HMAC-SHA256 signing of:
#   - Admin session authentication cookies
#   - Secure 7-day document download tokens sent in internal sales emails
# Required: Application throws an error if this is not defined.
# You can generate a strong random secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   or: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_secure_random_32_or_64_character_secret


# ------------------------------------------------------------------------------
# 3. Admin Dashboard Authentication
# ------------------------------------------------------------------------------
# Used by: src/lib/admin-auth.ts, src/app/api/admin/login/route.ts
# Credentials to access the lead management panel at `/admin/leads` (via `/admin/login`).
# If left empty or undefined, admin access is disabled as a safe default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password


# ------------------------------------------------------------------------------
# 4. Environment & Deployment (Optional / Standard)
# ------------------------------------------------------------------------------
# NODE_ENV controls cookie security flags in admin authentication
# Set automatically by Next.js in most hosting environments
NODE_ENV=development


# ------------------------------------------------------------------------------
# 5. Spam protection: Cloudflare Turnstile (optional)
# ------------------------------------------------------------------------------
# Used by: src/components/Turnstile.tsx, src/lib/turnstile.ts
# Adds Cloudflare's invisible "are you human" check to every lead form. Without
# these, forms are still protected by a honeypot field and a per-IP rate limit
# (8 submissions per 10 minutes). Create a free widget at
# https://dash.cloudflare.com (Turnstile section), then set BOTH values.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is baked in at build time: rebuild after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ------------------------------------------------------------------------------
# 6. Analytics: Google Analytics 4 (optional)
# ------------------------------------------------------------------------------
# Used by: src/components/Analytics.tsx
# GA4 measurement ID (looks like G-XXXXXXXXXX). Tracks page views plus
# "generate_lead", "whatsapp_click" and "email_click" events. Leave empty to
# load no analytics at all. Baked in at build time: rebuild after changing it.
NEXT_PUBLIC_GA_ID=
