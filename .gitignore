# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# lead data (contains customer PII) — never commit
/data/

# gated sales documents — these are only meant to be reachable through the
# signed lead-capture download link (see README). Committing them to git
# would let anyone with repo access grab them directly, bypassing the lead
# form entirely — and several of the source PDFs are 100MB+, over GitHub's
# per-file limit anyway. Deploy these to the host separately (see README).
/protected-documents/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
